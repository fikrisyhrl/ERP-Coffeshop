# Server Configuration
PORT=5000
NODE_ENV=development

# =========================================================================
# 1. KONEKSI SUPABASE POSTGRESQL (DIREKOMENDASIKAN)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Contoh format: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# =========================================================================
DATABASE_URL=

# Alternatif parameter terpisah jika tidak menggunakan URI:
# DB_DIALECT=postgres
# DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your_password

# =========================================================================
# 2. FALLBACK KONEKSI MYSQL LOKAL (XAMPP)
# Aktif otomatis jika DATABASE_URL di atas dikosongkan
# =========================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=erp_coffeeshop
DB_USER=root
DB_PASSWORD=

